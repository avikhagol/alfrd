{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alfrd.dev/schemas/plugin_catalog.v1.json",
  "title": "ALFRD plugin catalog (index.json), version 1",
  "type": "object",
  "required": ["schema_version", "plugins"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "maxLength": 120},
    "plugins": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["id", "title", "kinds", "alfrd_api", "versions"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,40}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "maxLength": 2000},
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["theme", "viewer", "panel", "converter", "cli"]}
        },
        "requires_bin": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"}
        },
        "alfrd_api": {"type": "string", "pattern": "^\\s*(>=|<=|==|!=|>|<)\\s*[0-9]+(\\.[0-9]+)*\\s*(,\\s*(>=|<=|==|!=|>|<)\\s*[0-9]+(\\.[0-9]+)*\\s*)*$"},
        "homepage": {"type": "string", "pattern": "^https://", "maxLength": 2048},
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/version"}
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["version", "wheel", "sha256"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"},
        "wheel": {"type": "string", "pattern": "^(https|file)://[^\\s]+\\.whl$", "maxLength": 2048},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requirements": {
          "description": "Every non-host dependency, pinned and hashed (installs use --require-hashes --no-deps).",
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*==[A-Za-z0-9.+!-]+( --hash=sha256:[0-9a-f]{64})+$"}
        }
      }
    }
  }
}
