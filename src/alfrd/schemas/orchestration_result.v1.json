{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avikhagol/alfrd/schemas/orchestration_result.v1.json",
  "title": "alfrd.orchestration/1 result",
  "description": "What a task produced. ALFRD fills usage from the provider's report; an agent's own usage figures are ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "status": {
      "enum": [
        "done",
        "failed",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        ]
      },
      "description": "Artifact refs (path@sha256) or paths; ALFRD records each as a ref with the file's actual hash."
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_uncached_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "orchestration_blocker.v1.json"
      },
      "maxItems": 10
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "orchestration_task.v1.json"
      },
      "maxItems": 20,
      "description": "Sub-tasks this task delegates (one level deeper; bounded by chat.bounds.max_depth)."
    },
    "outputs_changed": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output",
          "to"
        ],
        "properties": {
          "output": {
            "type": "string",
            "pattern": "^o[1-9][0-9]{0,2}$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "description": "Expected outputs (o1, o2, …) this task wrote somewhere else: the new absolute path and why. ALFRD checks the path is inside the task's writable folders, then checks and passes on the new path."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "blockers"
        ],
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
