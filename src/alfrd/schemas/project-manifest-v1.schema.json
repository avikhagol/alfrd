{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alfrd.dev/schemas/project-manifest-v1.schema.json",
  "title": "ALFRD Project Manifest v1",
  "type": "object",
  "required": ["name"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "cmd"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "cmd": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "schema": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "definitions"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "definitions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
