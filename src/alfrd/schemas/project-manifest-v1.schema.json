{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avikhagol.github.io/alfrd/schemas/project-manifest-v1.schema.json",
  "title": "ALFRD Project Manifest v1",
  "type": "object",
  "required": ["name"],
  "properties": {
    "project_settings": {
      "type": "object",
      "properties": {
        "personas": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,39}$": {
              "type": "object", "required": ["label", "instructions"],
              "properties": {
                "label": {"type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\r\\n]+$"},
                "instructions": {"type": "string", "maxLength": 4000},
                "summary": {"type": "string", "maxLength": 1000}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "agent_access": {
          "type": "object",
          "properties": {
            "folders": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "bash_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "sandbox": {"enum": ["read-only", "workspace-write"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "quickstart": {
      "type": "object",
      "description": "Setup forms (Studio → Setup wizard). Each form writes its fields to target.file: a key = value file, or alfrd.yaml (dotted field keys).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "fields"
        ],
        "properties": {
          "type": {
            "const": "form"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "file"
                ]
              }
            ]
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "anyOf": [
                {
                  "enum": [
                    "textbox",
                    "text",
                    "textarea",
                    "number",
                    "toggle",
                    "checkbox",
                    "path",
                    "select",
                    "list"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "textbox",
                        "text",
                        "textarea",
                        "number",
                        "toggle",
                        "checkbox",
                        "path",
                        "select",
                        "list"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "notify": {
      "type": "object",
      "properties": {
        "idle_after": {
          "type": ["number", "boolean"],
          "description": "Seconds without unit activity before turn.idle (default 600; 0 or false disables)."
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["via", "on"],
            "properties": {
              "via": {"type": "string", "minLength": 1, "not": {"enum": ["webhook", "command", "telegram"]},
                      "description": "Notifier; webhook, command and telegram are only allowed in the user's notify.json."},
              "on": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                ],
                "description": "Event kinds or prefixes such as plan.*."
              }
            }
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "properties": {
        "max_input_chars": {"type": "integer", "minimum": 1, "default": 40000},
        "progress": {"oneOf": [{"type": "boolean"}, {"type": "string", "minLength": 1, "pattern": "^[^\\n]+$"}], "default": true, "description": "Agents keep a checklist file in their working folder and continue from it each turn (true: PROGRESS.md in a task worktree, PROGRESS-<task>.md in a shared folder; a name; false = off)."},
        "workspace": {"enum": ["shared", "worktree"], "default": "shared"},
        "task_row": {"type": "string", "minLength": 1},
        "headings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n]+$"
          }
        },
        "contract": {
          "type": "object",
          "properties": {
            "first": {
              "type": "string"
            },
            "middle": {
              "type": "string"
            },
            "final": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "cmd"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "stdin_file": {"type": "string", "minLength": 1},
          "output_file": {"type": "string", "minLength": 1},
          "output_capture": {"enum": ["file", "stdout"]},
          "cwd": {"type": "string", "minLength": 1},
          "manual": {"type": "boolean"},
          "human_review": {"type": "boolean"},
          "model": {"type": ["string", "null"], "minLength": 1},
          "adapter": {"enum": ["claude", "codex", "generic"]},
          "model_option": {"type": "string", "pattern": "^--?[A-Za-z0-9][A-Za-z0-9-]*$"},
          "fallback_models": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "lean": {"type": "boolean", "description": "Claude: start without MCP servers, user plugins/settings and skills (docs/agent-loops.md)."},
          "mcp": {"oneOf": [{"enum": ["none", "default"]}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]},
          "plugins": {"type": "boolean"},
          "skills": {"type": "boolean"},
          "timeout": {"type": "number", "exclusiveMinimum": 0},
          "env": {"type": "object"},
          "cmd": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "schema": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "definitions"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "definitions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "path_pattern"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path_pattern": {"type": "string", "minLength": 1},
          "fallback_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "description": {"type": "string"},
          "media_type": {"type": ["string", "null"]},
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory",
              "table",
              "json",
              "yaml",
              "text",
              "log",
              "image",
              "image_collection",
              "collection",
              "html",
              "archive"
            ]
          },
          "viewer": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "chat": {
      "type": "object",
      "description": "Project chat (docs/orchestration.md): role presets of the chat agents, the orchestrator and per-request bounds, merged over ALFRD's defaults.",
      "properties": {
        "orchestrator": {
          "type": "string"
        },
        "final_summary": {
          "type": "boolean"
        },
        "delegate_decisions": {
          "type": "string",
          "enum": ["off", "questions", "all"]
        },
        "watch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "interval_seconds": {
              "type": "integer",
              "anyOf": [{"const": 0}, {"minimum": 30}]
            },
            "stall_seconds": {"type": "integer", "minimum": 60},
            "wake_orchestrator": {"type": "boolean"},
            "max_checks": {"type": "integer", "minimum": 0}
          }
        },
        "orchestrator_model": {
          "type": ["string", "null"]
        },
        "escalation_model": {
          "type": ["string", "null"]
        },
        "warn_task_cost_usd": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "history_messages": {
          "type": "integer",
          "minimum": 0
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_depth": {
              "type": "integer",
              "minimum": 1
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "max_cost_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_tasks": {
              "type": "integer",
              "minimum": 1
            },
            "max_replans": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "agents": {
          "type": "object",
          "description": "Agent key → preset; null removes a default preset.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "entrypoint": {
                    "type": "string"
                  },
                  "cmd": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "model": {
                    "type": "string"
                  },
                  "adapter": {
                    "type": "string",
                    "enum": [
                      "claude",
                      "codex",
                      "generic"
                    ]
                  },
                  "roles": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "persona": {
                    "type": "string"
                  },
                  "timeout": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "lean": {
                    "type": "boolean"
                  },
                  "env": {
                    "type": "object",
                    "description": "Added to this agent's command environment (e.g. ANTHROPIC_BASE_URL for Claude Code on Ollama).",
                    "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                    "additionalProperties": {"type": ["string", "number"]}
                  },
                  "fallback": {
                    "type": "string",
                    "description": "Another chat agent: a failed attempt that hit a usage/rate/quota limit or an unavailable model moves the row there (one hop each, no loops)."
                  },
                  "model_option": {
                    "type": "string",
                    "pattern": "^--?[A-Za-z0-9][A-Za-z0-9-]*$"
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "object",
      "description": "Per-project plugin settings: whether a plugin applies to this project. Overrides the global setting and the plugin's default (docs/plugins.md, Project types).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {"type": "boolean", "description": "false turns the plugin off for this project; true turns it on whatever its project types say."},
          "project_types": {
            "description": "Project types (template names) the plugin applies to, or \"all\".",
            "oneOf": [
              {"type": "string", "enum": ["all"]},
              {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "summaries": {
      "type": "object",
      "maxProperties": 2,
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 120},
            "rows": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "required": ["step", "parameter", "value"],
                "properties": {
                  "step": {"type": "string", "minLength": 1, "maxLength": 255},
                  "parameter": {"type": "string", "minLength": 1, "maxLength": 255},
                  "source": {"type": "string", "minLength": 1, "maxLength": 255},
                  "value": {"type": ["string", "number", "boolean", "null"], "maxLength": 4096}
                },
                "additionalProperties": false
              }
            }
          },
          "required": ["rows"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 120},
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 9,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "dataset", "step", "status", "attempt", "duration_seconds",
                  "finished_at", "result_summary", "error_summary", "artifact_count"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
