{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avikhagol.github.io/alfrd/schemas/project-manifest-v1.schema.json",
  "title": "ALFRD Project Manifest v1",
  "type": "object",
  "required": ["name"],
  "properties": {
    "project_settings": {
      "type": "object",
      "properties": {
        "agent_access": {
          "type": "object",
          "properties": {
            "folders": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "bash_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "sandbox": {"enum": ["read-only", "workspace-write"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "loop": {
      "type": "object",
      "properties": {
        "task_row": {"type": "string", "minLength": 1},
        "headings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n]+$"
          }
        },
        "contract": {
          "type": "object",
          "properties": {
            "first": {
              "type": "string"
            },
            "middle": {
              "type": "string"
            },
            "final": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "cmd"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "stdin_file": {"type": "string", "minLength": 1},
          "output_file": {"type": "string", "minLength": 1},
          "output_capture": {"enum": ["file", "stdout"]},
          "cwd": {"type": "string", "minLength": 1},
          "manual": {"type": "boolean"},
          "human_review": {"type": "boolean"},
          "model": {"type": ["string", "null"], "minLength": 1},
          "timeout": {"type": "number", "exclusiveMinimum": 0},
          "env": {"type": "object"},
          "cmd": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "schema": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "definitions"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "definitions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "path_pattern"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path_pattern": {"type": "string", "minLength": 1},
          "fallback_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "description": {"type": "string"},
          "media_type": {"type": ["string", "null"]},
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory",
              "table",
              "json",
              "yaml",
              "text",
              "log",
              "image",
              "image_collection",
              "collection",
              "html",
              "archive"
            ]
          },
          "viewer": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "summaries": {
      "type": "object",
      "maxProperties": 2,
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 120},
            "rows": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "required": ["step", "parameter", "value"],
                "properties": {
                  "step": {"type": "string", "minLength": 1, "maxLength": 255},
                  "parameter": {"type": "string", "minLength": 1, "maxLength": 255},
                  "source": {"type": "string", "minLength": 1, "maxLength": 255},
                  "value": {"type": ["string", "number", "boolean", "null"], "maxLength": 4096}
                },
                "additionalProperties": false
              }
            }
          },
          "required": ["rows"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 120},
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 9,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "dataset", "step", "status", "attempt", "duration_seconds",
                  "finished_at", "result_summary", "error_summary", "artifact_count"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
