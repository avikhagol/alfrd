{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avikhagol/alfrd/schemas/orchestration_envelope.v1.json",
  "title": "alfrd.orchestration/1 envelope",
  "description": "Every structured message between ALFRD and an agent. kind=plan (orchestrator: reply + tasks + decisions), result (a task's outcome), summary (the orchestrator's final answer), blocker, decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "kind"
  ],
  "properties": {
    "protocol": {
      "const": "alfrd.orchestration/1"
    },
    "kind": {
      "enum": [
        "plan",
        "result",
        "summary",
        "blocker",
        "decision"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 20000
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "orchestration_task.v1.json"
      },
      "maxItems": 50
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "orchestration_decision.v1.json"
      },
      "maxItems": 20
    },
    "result": {
      "$ref": "orchestration_result.v1.json"
    },
    "blocker": {
      "$ref": "orchestration_blocker.v1.json"
    },
    "decision": {
      "$ref": "orchestration_decision.v1.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plan"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "tasks"
            ]
          },
          {
            "required": [
              "message"
            ]
          },
          {
            "required": [
              "decisions"
            ]
          }
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "result"
              ]
            },
            {
              "required": [
                "blocker"
              ]
            },
            {
              "required": [
                "decision"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "summary"
          }
        }
      },
      "then": {
        "required": [
          "message"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "blocker"
          }
        }
      },
      "then": {
        "required": [
          "blocker"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "required": [
          "decision"
        ]
      }
    }
  ]
}
