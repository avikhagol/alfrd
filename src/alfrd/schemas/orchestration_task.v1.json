{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avikhagol/alfrd/schemas/orchestration_task.v1.json",
  "title": "alfrd.orchestration/1 task",
  "description": "One task assignment: who does what, after which tasks, how it is judged, with which inputs and within which budget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "owner",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "description": "Unique within the plan (or result) that proposes it."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$",
      "description": "A chat agent key (chat.agents in alfrd.yaml)."
    },
    "role": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 8000,
      "description": "What to do, in the owner's terms. Task-specific context only."
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      },
      "uniqueItems": true,
      "maxItems": 50
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 1,
      "maxItems": 30
    },
    "inputs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[^@\\s][^@]*@(sha256:)?[0-9a-f]{64}$",
            "description": "A versioned artifact reference: <project-relative path>@<sha256 hex>."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[^@\\s][^@]*@(sha256:)?[0-9a-f]{64}$",
                "description": "A versioned artifact reference: <project-relative path>@<sha256 hex>."
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        ]
      }
    },
    "expected_outputs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  }
}
